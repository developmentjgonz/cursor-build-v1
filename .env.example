DFLOW_TRADE_API_URL=https://dev-quote-api.dflow.net
DFLOW_PROOF_API_URL=https://proof.dflow.net
DFLOW_API_KEY=
KALSHI_API_BASE_URL=https://api.elections.kalshi.com
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

